# Copy to .env.local for local development. None of these are required to run
# the site; every one of them has a safe default.

# Public origin. Set this for any deployment that is NOT the GitHub Pages
# project subdirectory. Setting it also switches off the /glitter-game-day
# path prefix, so do not set it while serving from albertrus.github.io.
# NEXT_PUBLIC_SITE_URL=https://glittergameday.com

# Google Analytics 4 measurement ID. If this is empty, no analytics script is
# loaded at all, which is the correct default until the privacy page says the
# site uses analytics.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
